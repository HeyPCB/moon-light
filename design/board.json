{
 "name": "moon_light",
 "title": "Luna - night-light moon: auto-on amber glow, light sensor, touch, sleep timer, USB-C",
 "revision": "A",
 "brief": "A crescent-moon night light on USB-C. An APDS-9306 measures the room's light over I2C; when it goes dark a CH32V003 (3.3 V from an XC6206) fades eight orange 605 nm LEDs, each with its own 220 ohm from 5 V, up through one AO3400A on a PWM pin, and fades them out after a sleep timer. A gold touch pad on the moon's cheek switches it by hand and sets the timer. A keyhole cutout hangs it on a nail. 2 layers, single-sided SMT, blue mask, ENIG.",
 "blocks": [
  {
   "block": "usb_c_data_5v",
   "as": "usb",
   "title": "USB-C: 5 V in (data pins unused)",
